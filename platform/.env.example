# Copy with: node platform/examples/init-production-env.mjs
# Empty secrets intentionally prevent docker compose from starting this template.
POSTGRES_PASSWORD=
NAKAMA_SERVER_KEY=
NAKAMA_HTTP_KEY=
NAKAMA_SESSION_KEY=
NAKAMA_REFRESH_KEY=
NAKAMA_CONSOLE_PASSWORD=
ARCANE_GATEWAY_KEY=
ARCANE_ADMIN_KEY=
ARCANE_TOKEN_SECRET=
ARCANE_ADMIN_TOKEN=
ARCANE_MATCH_PRIVATE_KEY=
# SPKI PEM encoded as base64; needed only by an external authority verifier.
ARCANE_MATCH_PUBLIC_KEY=

# Trusted launcher/API host. Secure cookies are enabled from this HTTPS URL.
ARCANE_PUBLIC_URL=https://play.example.com
ARCANE_ALLOWED_ORIGINS=https://play.example.com
# Immutable, untrusted game content; never add this to ALLOWED_ORIGINS.
ARCANE_GAME_ORIGINS=https://game-content.example.net
ARCANE_HOST_PORT=7400
# Runtime allowlist for the bundled authoritative adapters.
ARCANE_ADAPTER_IDS=turn-based-v1,score-race-v1
# JSON mapping publisherId to SHA-256(publisher token), not plaintext tokens.
ARCANE_PUBLISHER_KEYS={}
# Optional trusted single-hop reverse proxy TCP peer IPs; exact IPs, no CIDRs.
# Leave empty until you know the proxy source address seen by the gateway.
ARCANE_TRUSTED_PROXY_IPS=
