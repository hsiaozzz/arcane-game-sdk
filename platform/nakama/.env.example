# Run node init-local.mjs to create an ignored .env with random keys.
POSTGRES_PASSWORD=replace-with-a-random-local-password
NAKAMA_SERVER_KEY=replace-with-random-server-key
NAKAMA_HTTP_KEY=replace-with-a-different-random-http-key
NAKAMA_SESSION_KEY=replace-with-random-session-key
NAKAMA_REFRESH_KEY=replace-with-random-refresh-key
NAKAMA_CONSOLE_PASSWORD=replace-with-random-console-password
ARCANE_GATEWAY_KEY=replace-with-random-32-byte-gateway-key
ARCANE_ADMIN_KEY=replace-with-different-random-32-byte-admin-key
ARCANE_ADAPTER_IDS=turn-based-v1,robo-rumble-authoritative-v1
NAKAMA_API_PORT=7354
NAKAMA_CONSOLE_PORT=7355
