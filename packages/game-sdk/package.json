{
  "name": "@arcane/game-sdk",
  "version": "0.1.0",
  "description": "Scoped browser capabilities for games hosted by Arcane.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "index.d.ts",
    "README.md",
    "API.md",
    "examples",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsiaozzz/arcane-game-sdk.git",
    "directory": "packages/game-sdk"
  },
  "homepage": "https://github.com/hsiaozzz/arcane-game-sdk#readme",
  "bugs": {
    "url": "https://github.com/hsiaozzz/arcane-game-sdk/issues"
  },
  "keywords": [
    "game",
    "sdk",
    "multiplayer",
    "nakama",
    "leaderboards",
    "matchmaking"
  ]
}
